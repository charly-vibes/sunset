# editors
*.swp
.idea/
.vscode/

# tool state
.target/
target/
node_modules/
__pycache__/
.pytest_cache/
.hypothesis/

# uv-managed virtualenv (recreate with `uv sync` from the committed uv.lock)
.venv/

# devenv.sh state (see devenv.nix, tambor/DDL-irv pattern)
.devenv/
.devenv.flake.nix

# OS
.DS_Store

# Beads / Dolt internal state (track only issues.jsonl + config for backup)
.beads/*
!.beads/config.yaml
!.beads/issues.jsonl
.beads.gate.lock

# wai local noise (workspace itself is tracked; .wai/.gitignore filters the rest)

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
.env
.visual-review/
.pretender/

# local-smoke real-run directories: heavy derivable blobs (renders/crops/source
# copy) stay local; every digest is recorded in local-smoke/manifest.json and
# the runs are reproducible from the committed configs + pinned stack.
fixtures/digitization/local-smoke/baseline/artifacts/
fixtures/digitization/local-smoke/regional/artifacts/
fixtures/digitization/local-smoke/*/source.pdf
fixtures/digitization/local-smoke/*/budget-state.json.lock
